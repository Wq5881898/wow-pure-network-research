+++ b/pkg/world/connection_evidence_test.go
@@ -0,0 +1,31 @@
+package world
+
+import (
+ "encoding/binary"
+ "testing"
+ "time"
+)
+
+func TestConnectionEvidenceValidation(t *testing.T) {
+ s := &Session{started: time.Now(), state: State{Status: InWorld}}
+ timer := time.NewTimer(time.Minute)
+ defer timer.Stop()
+ e := engine{s:s, timing:timings{pong:time.Second}, pongTimer:timer,
+  pings:map[uint32]time.Time{7:time.Now(), 8:time.Now().Add(-2*time.Second)}}
+ for _, id := range []uint32{99,8} {
+  if _, err := e.handle(0x1dd,binary.LittleEndian.AppendUint32(nil,id)); err != nil { t.Fatal(err) }
+  if s.ConnectionEvidenceV1().LastValidPongMS != nil { t.Fatal("invalid Pong recorded") }
+ }
+ if _, err := e.handle(0x1dd,binary.LittleEndian.AppendUint32(nil,7)); err != nil { t.Fatal(err) }
+ at := s.connectionEvidence.received
+ for i:=0; i<3; i++ { if !s.ConnectionEvidenceV1().ValidPong { t.Fatal("matched Pong rejected") } }
+ if !s.connectionEvidence.received.Equal(at) { t.Fatal("query renewed watchdog") }
+ s.connectionEvidence.received = time.Now().Add(-2*time.Second)
+ if s.ConnectionEvidenceV1().ValidPong { t.Fatal("expired evidence accepted") }
+ s.connectionEvidence.received = time.Now()
+ s.state.Status = Failed
+ if s.ConnectionEvidenceV1().ValidPong { t.Fatal("failed session accepted") }
+}
+
+func TestConnectionEvidenceIdentityDiffersAcrossSessions(t *testing.T) {
+ first := startTestSession(t, quietTimings(), func(p *testPeer) { p.login(); p.closed() })
+ second := startTestSession(t, quietTimings(), func(p *testPeer) { p.login(); p.closed() })
+ a, b := first.ConnectionEvidenceV1().SessionID, second.ConnectionEvidenceV1().SessionID
+ if a == "" || b == "" || a == b { t.Fatal("session identity is absent or reused") }
+ if err := first.Close(); err != nil { t.Fatal(err) }
+ if err := second.Close(); err != nil { t.Fatal(err) }
+}
