+package worldrpc
+
+import (
+ "strings"
+ "testing"
+ "github.com/agent-wow/agent-wow/pkg/world"
+)
+
+type evidenceSession struct { fakeSession }
+func (*evidenceSession) ConnectionEvidenceV1() world.ConnectionEvidenceV1 {
+ return world.ConnectionEvidenceV1{SchemaVersion:1, Status:world.InWorld,
+  CharacterGUID:9007199254740993}
+}
+func TestConnectionEvidenceRouteV1(t *testing.T) {
+ request := `{"jsonrpc":"2.0","id":1,"method":"session.connectionEvidenceV1"}`
+ reply := call(Handler(&evidenceSession{}),request).Body.String()
+ if !strings.Contains(reply,`"schema_version":1`) ||
+  !strings.Contains(reply,`"character_guid":"9007199254740993"`) ||
+  !strings.Contains(reply,`"valid_pong":false`) {
+  t.Fatal(reply)
+ }
+ legacy := call(Handler(&fakeSession{}),request).Body.String()
+ if !strings.Contains(legacy,`"code":-32601`) { t.Fatal(legacy) }
+ args := call(Handler(&evidenceSession{}),
+  `{"jsonrpc":"2.0","id":1,"method":"session.connectionEvidenceV1","params":{"probe":true}}`).Body.String()
+ if !strings.Contains(args,`"code":-32602`) { t.Fatal(args) }
+}
