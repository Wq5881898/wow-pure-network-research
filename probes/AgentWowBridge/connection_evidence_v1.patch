--- /dev/null
+++ b/pkg/world/connection_evidence.go
@@ -0,0 +1,50 @@
+package world
+
+import "time"
+
+// connectionEvidence is updated only after the owner matches an unexpired Ping.
+type connectionEvidence struct {
+	received time.Time
+	validFor time.Duration
+	pingID uint32
+}
+
+// ConnectionEvidenceV1 is a read-only snapshot, not permission for gameplay.
+// All times are relative to this process's session origin, never wall time.
+type ConnectionEvidenceV1 struct {
+	SchemaVersion int `json:"schema_version"`
+	SessionID string `json:"session_id"`
+	Status Status `json:"status"`
+	CharacterGUID uint64 `json:"character_guid,string"`
+	SampledAtMS int64 `json:"sampled_at_ms"`
+	LastValidPongMS *int64 `json:"last_valid_pong_ms"`
+	PingID *uint32 `json:"ping_id"`
+	ValidForMS int64 `json:"valid_for_ms"`
+	ValidPong bool `json:"valid_pong"`
+	Error string `json:"error,omitempty"`
+}
+
+func (s *Session) ConnectionEvidenceV1() ConnectionEvidenceV1 {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	now := time.Now()
+	out := ConnectionEvidenceV1{
+		SchemaVersion: 1, Status: s.state.Status,
+		SessionID: s.connectionID,
+		CharacterGUID: s.state.Character.GUID,
+		SampledAtMS: now.Sub(s.started).Milliseconds(),
+		Error: s.state.Error,
+	}
+	if !s.connectionEvidence.received.IsZero() {
+		e := s.connectionEvidence
+		at := e.received.Sub(s.started).Milliseconds()
+		id := e.pingID
+		out.LastValidPongMS = &at
+		out.PingID = &id
+		out.ValidForMS = e.validFor.Milliseconds()
+		out.ValidPong = now.Sub(e.received) >= 0 && now.Sub(e.received) < e.validFor &&
+			(s.state.Status == InWorld || s.state.Status == LoggingOut)
+	}
+	return out
+}
+
+// Querying this snapshot performs no writes and never resets the watchdog.
+// A missing or expired Pong remains false, even if the RPC is responsive.
